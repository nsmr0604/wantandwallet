{
  "name": "wantandwallet",
  "version": "0.1.0",
  "description": "遊戯王 OCG のシングル買い（店舗巡回・価格比較・購入記録・月次予算）と新弾（定価・予約）を管理する個人用 PWA。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "vitest run",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "fetch:shops": "node scripts/fetch-konami-shops.mjs",
    "fetch:shops:osm": "node scripts/fetch-shops.mjs",
    "fetch:cards": "node --max-old-space-size=4096 scripts/build-card-index.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nsmr0604/wantandwallet.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/nsmr0604/wantandwallet/issues"
  },
  "homepage": "https://github.com/nsmr0604/wantandwallet#readme",
  "private": true,
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@sveltejs/vite-plugin-svelte": "^7.3.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.11",
    "fake-indexeddb": "^6.2.8",
    "svelte": "^5.59.2",
    "svelte-check": "^4.7.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.2",
    "wrangler": "^4.169.0"
  },
  "dependencies": {
    "dexie": "^4.4.7",
    "dexie-export-import": "^4.4.2"
  }
}
